APP_NAME=IDMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000
APP_LOCALE=bn
APP_FALLBACK_LOCALE=en

FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_STACK=single,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database - PostgreSQL with PostGIS
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=idms_db
DB_USERNAME=idms_user
DB_PASSWORD=idms_password
DB_SCHEMA=public,core,beneficiary,disaster,damage,logistics,distribution,project,volunteer,workflow,notification,document,audit

# Session & Cache Drivers
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Cache Store - Redis
CACHE_STORE=redis
CACHE_PREFIX=idms_cache

# Redis Configuration (predis client)
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Keycloak Sovereign IAM Configuration
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=idms-gov-realm
KEYCLOAK_CLIENT_ID=idms-backend-api
KEYCLOAK_PUBLIC_KEY=
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/idms-gov-realm/protocol/openid-connect/certs
KEYCLOAK_TOKEN_ISSUER=http://localhost:8080/realms/idms-gov-realm
KEYCLOAK_TOKEN_AUDIENCE=idms-backend-api
KEYCLOAK_JWKS_CACHE_TTL=86400
KEYCLOAK_ADMIN_DRIVER=mock
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_TIMEOUT_SECONDS=5

# Security & PII Encryption
PII_HMAC_SECRET=idms_hmac_secret_key_change_in_production
PII_AES_KEY=base64:aes256gcm_key_change_in_production

# National ID Verification Gateway (use 'mock' only in local/testing)
NID_VERIFICATION_DRIVER=mock
NID_API_BASE_URL=
NID_API_VERIFY_PATH=
NID_API_KEY=
NID_API_SSL_CERT_PATH=
NID_API_SSL_KEY_PATH=
NID_API_TIMEOUT_SECONDS=5
NID_API_MAX_RETRIES=2
NID_API_RETRY_DELAY_MS=250
NID_RATE_LIMIT_PER_MINUTE=30
NID_VERIFICATION_ASYNC=false

# Mail Configuration
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@modmr.gov.bd"
MAIL_FROM_NAME="${APP_NAME}"

# Notification Gateways (Module 13 - Keep credentials in environment only)
SMS_GATEWAY_DRIVER=mock
SMS_API_BASE_URL=
SMS_API_KEY=
SMS_API_USERNAME=
SMS_SENDER_ID=MoDMR-IDMS
SMS_API_TIMEOUT_SECONDS=5

PUSH_NOTIFICATION_DRIVER=mock
FCM_API_ENDPOINT=https://fcm.googleapis.com/fcm/send
FCM_SERVER_KEY=
PUSH_API_TIMEOUT_SECONDS=5
