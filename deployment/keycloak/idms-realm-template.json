{
  "id": "idms-gov-realm",
  "realm": "idms-gov-realm",
  "displayName": "IDMS National Disaster Management IAM",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 1800,
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": false, "priority": 10 },
    { "alias": "UPDATE_PASSWORD", "name": "Update Password", "providerId": "UPDATE_PASSWORD", "enabled": true, "defaultAction": false, "priority": 30 },
    { "alias": "UPDATE_PROFILE", "name": "Update Profile", "providerId": "UPDATE_PROFILE", "enabled": false, "defaultAction": false, "priority": 40 },
    { "alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": false, "defaultAction": false, "priority": 90 }
  ],
  "roles": {
    "realm": [
      { "name": "ROLE_SUPER_ADMIN", "description": "National MoDMR Lead System Administrator" },
      { "name": "ROLE_MINISTRY_EXECUTIVE", "description": "Minister, Senior Secretary, Executive Leadership" },
      { "name": "ROLE_NEOC_DIRECTOR", "description": "Director, National Emergency Operations Centre" },
      { "name": "ROLE_NATIONAL_AUDITOR", "description": "Auditor General & Statutory Audit Cell" },
      { "name": "ROLE_DDM_DIRECTOR_GENERAL", "description": "Director General, Department of Disaster Management" },
      { "name": "ROLE_DDM_RELIEF_DIRECTOR", "description": "Director (Relief, Logistics & Warehousing)" },
      { "name": "ROLE_DDM_PLANNING_DIRECTOR", "description": "Director (Planning, M&E & Reconstruction)" },
      { "name": "ROLE_DIVISIONAL_COMMISSIONER", "description": "Divisional Commissioner / Addl. Divisional Commissioner" },
      { "name": "ROLE_DEPUTY_COMMISSIONER", "description": "Deputy Commissioner (DC) / District Magistrate" },
      { "name": "ROLE_DRRO", "description": "District Relief and Rehabilitation Officer" },
      { "name": "ROLE_UNO", "description": "Upazila Nirbahi Officer" },
      { "name": "ROLE_PIO", "description": "Project Implementation Officer" },
      { "name": "ROLE_UP_CHAIRMAN", "description": "Union Parishad Chairman / Pourashava Mayor" },
      { "name": "ROLE_UP_SECRETARY", "description": "Union Parishad Secretary" },
      { "name": "ROLE_FIELD_ENUMERATOR", "description": "Ward Surveyor / Field Data Collector" },
      { "name": "ROLE_TAG_OFFICER", "description": "Government Verification & Inspection Officer" },
      { "name": "ROLE_WAREHOUSE_OFFICER", "description": "Central & Local Godown Keeper" },
      { "name": "ROLE_SHELTER_MANAGER", "description": "Cyclone / Flood Shelter In-Charge" },
      { "name": "ROLE_CPP_LEADER", "description": "Cyclone Preparedness Programme Unit Leader" },
      { "name": "ROLE_VOLUNTEER_RESPONDER", "description": "Red Crescent & Community First Responder" },
      { "name": "ROLE_EXTERNAL_PARTNER", "description": "UN Agencies & Humanitarian NGO Observers (WFP, UNICEF)" }
    ]
  },
  "clients": [
    {
      "clientId": "idms-spa-frontend",
      "name": "IDMS React SPA Client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "rootUrl": "http://localhost:5173",
      "baseUrl": "http://localhost:5173",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "https://*.modmr.gov.bd/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "https://*.modmr.gov.bd"
      ],
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "idms-backend-api",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "roles-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tier-level-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tier_level",
            "claim.name": "tier_level",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "ancestry-path-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "ancestry_path",
            "claim.name": "ancestry_path",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "designation-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "designation",
            "claim.name": "designation",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "scope-id-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "scope_id",
            "claim.name": "scope_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "idms-backend-api",
      "name": "IDMS Laravel Backend Resource Server",
      "enabled": true,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
